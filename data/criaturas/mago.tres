[resource]
script = ExtResource("1_ficha")
nombre = "Mago"
descripcion = "Frágil pero letal a distancia. Ataca con hechizos que gastan maná: proyectiles que nunca fallan, bolas de fuego que queman a varios, y curación."
fuerza = 8
destreza = 14
constitucion = 12
